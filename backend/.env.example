# Copy to backend/.env and fill in. Generate secrets with: python scripts/gen_keys.py

# production on Railway/Render
ENV=development
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:54329/impact
# Supabase (Project settings -> Database -> Connection string -> URI, "session" pooler, port 5432):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# https://yourdomain.com in production
FRONTEND_URL=http://localhost:3000

SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
COMMENT_HASH_SALT=

# Meta app (Instagram API with Instagram Login). Leave empty until the app exists;
# demo mode works without it.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# false in production once real creators sign in
DEMO_MODE=true

# Leave empty to use the rule-based classifier (no cost). Set to use Claude.
ANTHROPIC_API_KEY=

# Razorpay (test keys locally, live keys in production). Plan ids from Dashboard -> Subscriptions -> Plans.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_PRO_PLUS_MONTHLY=
RAZORPAY_PLAN_PRO_PLUS_YEARLY=
