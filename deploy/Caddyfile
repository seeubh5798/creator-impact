# Caddy gets and renews the Let's Encrypt certificate for the API domain by itself.
# API_DOMAIN comes from /opt/creator-impact/.env (e.g. api.yourdomain.com).

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format console
	}
}
