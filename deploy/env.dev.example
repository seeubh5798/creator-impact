# ============================================================================
# Proofluence DEV server config  ->  /opt/proofluence/.env on the DEV EC2 box
# NEVER commit the filled-in copy. This template is safe (no real values).
# Generate the 3 secrets with:  python3 backend/scripts/gen_keys.py
# ============================================================================

# yes, "production" even on dev: turns on secure cookies + secret checks
ENV=production

# Supabase project "proofluence-dev" -> Connect -> Session pooler URI (port 5432).
# Prefix must be postgresql+psycopg:// . URL-encode special chars in the password (@ -> %40).
DATABASE_URL=postgresql+psycopg://postgres.<dev-project-ref>:<dev-db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

FRONTEND_URL=https://dev.proofluence.com
API_DOMAIN=api-dev.proofluence.com

SECRET_KEY=<generate>
TOKEN_ENCRYPTION_KEY=<generate>
COMMENT_HASH_SALT=<generate>

# Meta app "Proofluence Dev" (separate from prod). Empty = demo only.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# keep the demo account on dev
DEMO_MODE=true

# Optional; empty = free rule-based classifier
ANTHROPIC_API_KEY=

# Razorpay TEST mode keys + TEST mode plan ids (rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_PRO_PLUS_MONTHLY=
RAZORPAY_PLAN_PRO_PLUS_YEARLY=
