# Production config. Copy to /opt/creator-impact/.env on the EC2 box.
# Generate the three secrets with:  python3 backend/scripts/gen_keys.py

ENV=production

# Supabase: Project settings -> Database -> Connection string -> URI (session pooler, port 5432)
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Your Amplify-hosted frontend
FRONTEND_URL=https://yourdomain.com

# Caddy serves the API on this hostname (A record -> this server's Elastic IP)
API_DOMAIN=api.yourdomain.com

SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
COMMENT_HASH_SALT=

# Meta app (Instagram API with Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# true while your pilot creators are Instagram testers; false once the Meta app is live
DEMO_MODE=true

# Optional. Empty = rule-based classifier.
ANTHROPIC_API_KEY=

# Razorpay (test keys locally, live keys in production). Plan ids from Dashboard -> Subscriptions -> Plans.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_PRO_PLUS_MONTHLY=
RAZORPAY_PLAN_PRO_PLUS_YEARLY=
